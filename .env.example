# Copy this file to ".env.local" and fill in the values. See SETUP.md.

# Supabase → Project Settings → API (or "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# The "Publishable" key (starts with sb_publishable_). The older "anon" key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The address the app runs at. Locally: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "true" only after setting up Google sign-in (optional, see SETUP.md)
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# OpenRouter (https://openrouter.ai) — powers reading job postings and, later,
# the application kits. Keep this secret: it is only used on the server.
OPENROUTER_API_KEY=
# Optional: which AI models to use (defaults shown).
# OPENROUTER_MODEL_FAST=anthropic/claude-haiku-5.5
# OPENROUTER_MODEL_WRITER=anthropic/claude-sonnet-5.5
