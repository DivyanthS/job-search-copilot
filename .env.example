# Copy this file to ".env.local" and fill in the values. See SETUP.md.

# Supabase → Project Settings → API (or "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# The "Publishable" key (starts with sb_publishable_). The older "anon" key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The address the app runs at. Locally: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "true" only after setting up Google sign-in (optional, see SETUP.md)
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# OpenAI (https://platform.openai.com) — powers reading job postings and the
# application kits. Keep this secret: it is only used on the server.
OPENAI_API_KEY=
# Optional: which OpenAI models to use (defaults shown).
# OPENAI_MODEL_FAST=gpt-6-luna
# OPENAI_MODEL_WRITER=gpt-6.2-sol

# Alternative to OpenAI: an OpenRouter key (https://openrouter.ai), which uses
# Claude models. Only used when OPENAI_API_KEY is empty.
OPENROUTER_API_KEY=
# Optional: which OpenRouter models to use (defaults shown).
# OPENROUTER_MODEL_FAST=anthropic/claude-haiku-5.5
# OPENROUTER_MODEL_WRITER=anthropic/claude-sonnet-5.5
