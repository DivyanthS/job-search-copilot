# Copy this file to ".env.local" and fill in the values. See SETUP.md.

# Supabase → Project Settings → API (or "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# The "Publishable" key (starts with sb_publishable_). The older "anon" key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The address the app runs at. Locally: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "true" only after setting up Google sign-in (optional, see SETUP.md)
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
